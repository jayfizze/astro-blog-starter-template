---
// src/pages/index.astro
// Component Script (Server-side)
const name = "Javon Phidd";
const title = "Operations Director | Project Manager";
const email = "jphidd@phiddoutsourcing.com.jm";
const location = "Tamarac, FL";

// --- SEO METADATA CONFIGURATION ---
const siteUrl = "https://phiddoutsourcing.com.jm"; 
const metaTitle = `${name} | ${title} - Operational Excellence`;
const metaDescription = `Portfolio of Javon Phidd, an Operations Director and Project Manager based in ${location}. 17+ years of experience leading cross-functional teams, optimizing technical infrastructure, and scaling operational efficiency.`;
const keywords = "Operations Director, Project Manager, Operational Excellence, Contact Center Management, Data Analytics, Javon Phidd, Tamarac FL Operations, Agile Leadership";

const metrics = [
  { value: 60, suffix: "%", label: "Performance Boost", desc: "Engineered workflows and sprint-based milestones that drove a 60% increase in team output within three months." },
  { value: 150, suffix: "+", label: "Seat Scale Management", desc: "Directed daily lifecycle operations for a massive international contact center, elevating productivity by 30%." },
  { value: 17, suffix: "", label: "Years Experience", desc: "Comprehensive history of leading cross-functional teams, executing high-stakes projects, and scaling operations." },
];

const capabilities = [
  { title: "Project Management & Methodology", desc: "Applying structured frameworks to define project scope, manage resources, mitigate risks, and ensure on-time delivery of complex organizational initiatives." },
  { title: "Operations & P&L Management", desc: "Comprehensive experience overseeing daily workflows, alignment with strict corporate SLAs, and optimizing operational budgets and profitability." },
  { title: "Data Analytics & KPI Tracking", desc: "Leveraging data-driven diagnostics to uncover operational bottlenecks, establish clear baselines, and design predictive performance reporting." },
  { title: "Risk, Compliance & Governance", desc: "Specialized expertise navigating state and federal regulations, managing quality assurance parameters, and establishing proactive fraud-prevention frameworks." },
];

// Structural JSON-LD Schema data for Google Rich Results
const schemaData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": name,
  "jobTitle": "Operations Director & Project Manager",
  "url": siteUrl,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Tamarac",
    "addressRegion": "FL",
    "addressCountry": "US"
  },
  "knowsAbout": [
    "Operations Management",
    "Project Management",
    "Data Analytics",
    "Risk Compliance",
    "Agile Methodologies",
    "AI Automation"
  ]
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Standard Primary SEO Tags -->
    <title>{metaTitle}</title>
    <meta name="title" content={metaTitle} />
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph / Facebook / LinkedIn Optimization -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} /> <!-- Place a preview image in public/og-image.jpg -->

    <!-- Twitter Profile Preview Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={metaTitle} />
    <meta property="twitter:description" content={metaDescription} />
    <meta property="twitter:image" content={`${siteUrl}/og-image.jpg`} />

    <!-- Structured JSON-LD Data Injection -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Google Font Performance Optimization -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Navigation Bar -->
    <nav class="navbar" aria-label="Main Navigation">
      <div class="nav-container">
        <a href="#" class="nav-logo" aria-label="Javon Phidd Home">{name}</a>
        <div class="nav-links">
          <a href="#about">About</a>
          <a href="#services">Services</a>
          <a href="#metrics">Impact</a>
          <a href="#skills">Capabilities</a>
          <a href="#contact" class="nav-cta">Contact</a>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <header class="hero">
      <div class="container">
        <p class="hero-subtitle">{title}</p>
        <h1 class="hero-title">Executing Strategic Projects and Delivering Operational Excellence.</h1>
        <p class="hero-lead">
          I bridge the gap between technical infrastructure, structured project execution, and human leadership. Leveraging certified methodologies, I transform chaotic legacy processes into predictable, high-performing systems that deliver visible bottom-line results.
        </p>
        <div class="hero-actions">
          <a href="https://phiddoutsourcing.zohobookings.com/#/phiddoutsourcing" target="_blank" class="btn btn-primary">Book A Meeting</a>
        </div>
      </div>
    </header>

    <!-- About Section -->
    <main>
      <section id="about" class="about" aria-labelledby="about-heading">
        <div class="container grid-2">
          <div class="section-header">
            <h2 id="about-heading" class="section-title">About Me</h2>
            <p class="section-subtitle">Where Process Planning Meets Active Execution</p>
          </div>
          <div class="about-content">
            <p>
              Over a nearly two-decade career, I have thrived at the intersection of business operations and structured project management. My leadership path spans managing high-capacity international contact centers, steering complex IT helpdesk infrastructure, and guiding cross-functional compliance operations as an <strong>Eligibility Specialist Supervisor</strong> for the State of Florida.
            </p>
            <p>
              I approach operations through a precise project management lens. Armed with professional credentials in <strong>Google Project Management</strong> and <strong>Google Data Analytics</strong>, I specialize in mapping out clear project life cycles, managing stakeholder expectations, eliminating resource waste, and building systemic accountability patterns.
            </p>
          </div>
        </div>
      </section>

      <!-- Services Section -->
      <section id="services" class="services" aria-labelledby="services-heading">
        <div class="container">
          <h2 id="services-heading" class="section-title centered">Professional Services</h2>
          <div class="services-grid">
            
            <!-- Service 1: Data Analytics -->
            <div class="service-card">
              <div class="service-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>
                </svg>
              </div>
              <h3>Data Analytics</h3>
              <p>We conduct a comprehensive review of your current data analytics processes. Our goal is to identify bottlenecks, optimize workflows, and enhance overall organizational proficiency, ensuring your data becomes a clear, actionable asset.</p>
              <a href="https://phiddoutsourcing.zohobookings.com/#/phiddoutsourcing" target="_blank" class="btn btn-primary service-btn">Book Consultation</a>
            </div>

            <!-- Service 2: Project Management -->
            <div class="service-card">
              <div class="service-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/>
                </svg>
              </div>
              <h3>Project Management</h3>
              <p>Whether you need a partner from the initial planning phase or require a consultant to step into an ongoing project, I provide full-lifecycle management. I take full responsibility for project coordination, ensuring milestones are met exactly as required.</p>
              <a href="https://phiddoutsourcing.zohobookings.com/#/phiddoutsourcing" target="_blank" class="btn btn-primary service-btn">Book Consultation</a>
            </div>

            <!-- Service 3: AI Automation -->
            <div class="service-card">
              <div class="service-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>
                </svg>
              </div>
              <h3>AI Automation</h3>
              <p>Unlock new levels of efficiency and productivity. I analyze your existing company policies and operational workflows to provide tailored, strategic recommendations on how AI automation can streamline your business and reduce manual overhead.</p>
              <a href="https://phiddoutsourcing.zohobookings.com/#/phiddoutsourcing" target="_blank" class="btn btn-primary service-btn">Book Consultation</a>
            </div>

          </div>
        </div>
      </section>

      <!-- Metrics Section -->
      <section id="metrics" class="metrics" aria-labelledby="metrics-heading">
        <div class="container">
          <h2 id="metrics-heading" class="section-title centered">Impact by the Numbers</h2>
          <div class="metrics-grid">
            {metrics.map((item) => (
              <div class="metric-card">
                <div class="metric-value-container">
                  <span class="metric-number" data-target={item.value}>0</span>
                  <span class="metric-suffix">{item.suffix}</span>
                </div>
                <h3 class="metric-label">{item.label}</h3>
                <p class="metric-desc">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Capabilities Section -->
      <section id="skills" class="skills" aria-labelledby="skills-heading">
        <div class="container">
          <h2 id="skills-heading" class="section-title centered">Core Capabilities</h2>
          <div class="skills-grid">
            {capabilities.map((tech) => (
              <div class="skill-card">
                <h3>{tech.title}</h3>
                <p>{tech.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>

    <!-- Footer / Contact Section -->
    <footer id="contact" class="footer" aria-label="Footer and Contact Information">
      <div class="container">
        <h2 class="footer-title">Let's Connect</h2>
        <p class="footer-lead">I am always open to discussing strategic project lifecycles, operations leadership roles, or program transformations.</p>
        <div class="footer-details">
          <p><strong>Location:</strong> {location}</p>
          <p><strong>Email:</strong> <a href={`mailto:${email}`}>{email}</a></p>
        </div>
        <div class="footer-socials">
          <a href="https://www.linkedin.com/in/jphidd" target="_blank" rel="noopener noreferrer" class="social-link">LinkedIn Profile</a>
        </div>
        <p class="copyright">&copy; {new Date().getFullYear()} {name}. All rights reserved.</p>
      </div>
    </footer>

    <!-- Client-side script for Animated Numbers -->
    <script>
      const setupAnimatedNumbers = () => {
        const counters = document.querySelectorAll('.metric-number');
        
        const startCounter = (counter) => {
          const target = parseInt(counter.getAttribute('data-target'), 10);
          const duration = 1500; 
          const startTime = performance.now();
          
          const updateNumber = (currentTime) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const easeProgress = progress * (2 - progress);
            
            counter.innerText = Math.floor(easeProgress * target).toString();
            
            if (progress < 1) {
              requestAnimationFrame(updateNumber);
            } else {
              counter.innerText = target.toString();
            }
          };
          
          requestAnimationFrame(updateNumber);
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              startCounter(entry.target);
              observer.unobserve(entry.target); 
            }
          });
        }, { threshold: 0.2 });

        counters.forEach(counter => observer.observe(counter));
      };

      setupAnimatedNumbers();
    </script>
  </body>
</html>

<!-- Scoped Styles -->
<style>
  :root {
    --bg-dark: #0f172a;
    --bg-card: #1e293b;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --accent: #38bdf8;
    --accent-hover: #7dd3fc;
    --border: #334155;
    --font: 'Inter', sans-serif;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    font-family: var(--font);
    line-height: 1.6;
    padding-top: 70px;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  @media (max-width: 768px) {
    .grid-2 { grid-template-columns: 1fr; gap: 2rem; }
  }

  /* Navbar */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    z-index: 1000;
    height: 70px;
    display: flex;
    align-items: center;
  }
  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .nav-logo {
    font-weight: 700;
    color: var(--text-main);
    text-decoration: none;
    font-size: 1.2rem;
  }
  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    margin-left: 1.5rem;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--accent); }
  .nav-links a.nav-cta {
    background: var(--accent);
    color: var(--bg-dark);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 500;
  }
  .nav-links a.nav-cta:hover { background: var(--accent-hover); }

  /* Hero */
  .hero {
    padding: 8rem 0 6rem 0;
    border-bottom: 1px solid var(--border);
  }
  .hero-subtitle {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .hero-title {
    font-size: 3rem;
    line-height: 1.2;
    font-weight: 800;
    margin-bottom: 1.5rem;
    max-width: 900px;
  }
  .hero-lead {
    color: var(--text-muted);
    font-size: 1.2rem;
    max-width: 750px;
    margin-bottom: 2.5rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
  }

  /* Buttons */
  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
    display: inline-block;
  }
  .btn-primary { background: var(--accent); color: var(--bg-dark); }
  .btn-primary:hover { background: var(--accent-hover); }
  .btn-secondary { border: 1px solid var(--border); color: var(--text-main); }
  .btn-secondary:hover { background: var(--border); }

  /* Sections General */
  section { padding: 6rem 0; border-bottom: 1px solid var(--border); }
  .section-title { font-size: 2rem; font-weight: 700; margin-bottom: 1rem; }
  .section-title.centered { text-align: center; margin-bottom: 4rem; }
  .section-subtitle { color: var(--text-muted); font-size: 1.1rem; }

  /* About */
  .about-content p { margin-bottom: 1.5rem; color: var(--text-muted); }
  .about-content strong { color: var(--text-main); }

  /* Services Section (New) */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  .service-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2.5rem 2rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, border-color 0.2s;
  }
  .service-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }
  .service-icon {
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  .service-icon svg {
    width: 48px;
    height: 48px;
  }
  .service-card h3 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }
  .service-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 2rem;
    flex-grow: 1;
  }
  .service-btn {
    text-align: center;
    width: 100%;
  }

  /* Metrics */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
  .metric-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2.5rem 2rem;
    border-radius: 12px;
    text-align: center;
  }
  .metric-value-container {
    color: var(--accent);
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .metric-label { font-size: 1.2rem; margin-bottom: 0.75rem; font-weight: 600; }
  .metric-desc { color: var(--text-muted); font-size: 0.95rem; }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .skill-card {
    border: 1px solid var(--border);
    padding: 2rem;
    border-radius: 8px;
    transition: transform 0.2s;
  }
  .skill-card:hover { transform: translateY(-4px); border-color: var(--accent); }
  .skill-card h3 { font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--text-main); }
  .skill-card p { color: var(--text-muted); font-size: 0.9rem; }

  /* Footer */
  .footer { padding: 6rem 0 3rem 0; text-align: center; background: #0b111e; }
  .footer-title { font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; }
  .footer-lead { color: var(--text-muted); max-width: 600px; margin: 0 auto 2.5rem auto; }
  .footer-details { margin-bottom: 2rem; }
  .footer-details a { color: var(--accent); text-decoration: none; }
  .footer-socials { margin-bottom: 4rem; }
  .social-link {
    color: var(--text-muted);
    text-decoration: none;
    margin: 0 1rem;
    font-weight: 500;
  }
  .social-link:hover { color: var(--accent); }
  .copyright { color: #475569; font-size: 0.85rem; }
</style>
