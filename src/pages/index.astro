---
// src/pages/index.astro
// Component Script (Server-side)
const name = "Javon Phidd";
const title = "Operations Director | Project Manager";
const email = "jphidd@phiddoutsourcing.com.jm";
const location = "Tamarac, FL";

const metrics = [
  { value: 60, suffix: "%", label: "Performance Boost", desc: "Engineered workflows that drove a 60% increase in team performance within three months." },
  { value: 150, suffix: "+", label: "Seat Scale Management", desc: "Directed daily operations for a massive international contact center, elevating productivity by 30%." },
  { value: 17, suffix: "", label: "Years Experience", desc: "Comprehensive experience managing, optimizing, and scaling complex customer-focused teams." },
];

const capabilities = [
  { title: "Operations & P&L Management", desc: "Comprehensive experience overseeing daily workflows, meeting strict SLAs, and managing operational profitability." },
  { title: "Data Analytics & KPI Tracking", desc: "Leveraging data analysis to uncover root causes, generate performance-specific reporting, and make data-driven decisions." },
  { title: "IT Infrastructure Leadership", desc: "Deep technical background supervising IT service desks, deploying software standards, and resolving complex systems issues." },
  { title: "Risk & Compliance Management", desc: "Specialized knowledge in navigating state/federal regulations, evaluating complex eligibility cases, and monitoring fraud prevention." },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name} | {title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Navigation Bar -->
    <nav class="navbar">
      <div class="nav-container">
        <a href="#" class="nav-logo">{name}</a>
        <div class="nav-links">
          <a href="#about">About</a>
          <a href="#metrics">Impact</a>
          <a href="#skills">Capabilities</a>
          <a href="#contact" class="nav-cta">Contact</a>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <header class="hero">
      <div class="container">
        <p class="hero-subtitle">{title}</p>
        <h1 class="hero-title">Driving Operational Excellence through Data, Leadership, and Innovation.</h1>
        <p class="hero-lead">
          I bridge the gap between technical strategy and human leadership to deliver measurable results. From implementing regional tracking systems to skyrocketing team performance, I transform operational challenges into streamlined, high-performing systems.
        </p>
        <div class="hero-actions">
          <a href="#contact" download class="btn btn-primary">Get In Touch</a>
         </div>
      </div>
    </header>

    <!-- About Section -->
    <section id="about" class="about">
      <div class="container grid-2">
        <div class="section-header">
          <h2 class="section-title">About Me</h2>
          <p class="section-subtitle">The Intersection of Strategy and Execution</p>
        </div>
        <div class="about-content">
          <p>
            Over nearly two decades, my career has spanned pivotal leadership roles—including serving as an <strong>IT Helpdesk Supervisor</strong>, <strong>Operations Manager</strong> for international brands, and my current role as an <strong>Eligibility Specialist Supervisor</strong> for the Florida Department of Children & Families.
          </p>
          <p>
            My approach combines data-driven strategy with a deep understanding of human workflow management. Armed with certifications in <strong>Google Data Analytics</strong> and <strong>Google Project Management</strong>, I don't just manage teams—I analyze performance metrics to engineer solutions that cut through inefficiency and boost productivity.
          </p>
        </div>
      </div>
    </section>

    <!-- Metrics Section -->
    <section id="metrics" class="metrics">
      <div class="container">
        <h2 class="section-title centered">Impact by the Numbers</h2>
        <div class="metrics-grid">
          {metrics.map((item) => (
            <div class="metric-card">
              <div class="metric-value-container">
                <span class="metric-number" data-target={item.value}>0</span>
                <span class="metric-suffix">{item.suffix}</span>
              </div>
              <h3 class="metric-label">{item.label}</h3>
              <p class="metric-desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Capabilities Section -->
    <section id="skills" class="skills">
      <div class="container">
        <h2 class="section-title centered">Core Capabilities</h2>
        <div class="skills-grid">
          {capabilities.map((tech) => (
            <div class="skill-card">
              <h3>{tech.title}</h3>
              <p>{tech.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Footer / Contact Section -->
    <footer id="contact" class="footer">
      <div class="container">
        <h2 class="footer-title">Let's Connect</h2>
        <p class="footer-lead">I am always open to discussing strategic operations, leadership opportunities, or technical consulting.</p>
        <div class="footer-details">
          <p><strong>Location:</strong> {location}</p>
          <p><strong>Email:</strong> <a href={`mailto:${email}`}>{email}</a></p>
        </div>
        <div class="footer-socials">
          <a href="#" class="www.linkedin.com/in/jphidd">LinkedIn</a>
        </div>
        <p class="copyright">&copy; {new Date().getFullYear()} {name}. All rights reserved.</p>
      </div>
    </footer>

    <!-- Client-side script for Animated Numbers -->
    <script>
      const setupAnimatedNumbers = () => {
        const counters = document.querySelectorAll('.metric-number');
        
        const startCounter = (counter) => {
          const target = parseInt(counter.getAttribute('data-target'), 10);
          const duration = 1500; // 1.5 seconds animation
          const startTime = performance.now();
          
          const updateNumber = (currentTime) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            
            // Ease out quad function for smooth stopping
            const easeProgress = progress * (2 - progress);
            
            counter.innerText = Math.floor(easeProgress * target);
            
            if (progress < 1) {
              requestAnimationFrame(updateNumber);
            } else {
              counter.innerText = target;
            }
          };
          
          requestAnimationFrame(updateNumber);
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              startCounter(entry.target);
              observer.unobserve(entry.target); // Run animation once
            }
          });
        }, { threshold: 0.2 });

        counters.forEach(counter => observer.observe(counter));
      };

      // Runs on initial page load
      setupAnimatedNumbers();
    </script>
  </body>
</html>

<!-- Scoped Styles -->
<style>
  :root {
    --bg-dark: #0f172a;
    --bg-card: #1e293b;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --accent: #38bdf8;
    --accent-hover: #7dd3fc;
    --border: #334155;
    --font: 'Inter', sans-serif;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    font-family: var(--font);
    line-height: 1.6;
    padding-top: 70px;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  @media (max-width: 768px) {
    .grid-2 { grid-template-columns: 1fr; gap: 2rem; }
  }

  /* Navbar */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    z-index: 1000;
    height: 70px;
    display: flex;
    align-items: center;
  }
  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .nav-logo {
    font-weight: 700;
    color: var(--text-main);
    text-decoration: none;
    font-size: 1.2rem;
  }
  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    margin-left: 1.5rem;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--accent); }
  .nav-links a.nav-cta {
    background: var(--accent);
    color: var(--bg-dark);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 500;
  }
  .nav-links a.nav-cta:hover { background: var(--accent-hover); }

  /* Hero */
  .hero {
    padding: 8rem 0 6rem 0;
    border-bottom: 1px solid var(--border);
  }
  .hero-subtitle {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .hero-title {
    font-size: 3rem;
    line-height: 1.2;
    font-weight: 800;
    margin-bottom: 1.5rem;
    max-width: 900px;
  }
  .hero-lead {
    color: var(--text-muted);
    font-size: 1.2rem;
    max-width: 750px;
    margin-bottom: 2.5rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
  }

  /* Buttons */
  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
    display: inline-block;
  }
  .btn-primary { background: var(--accent); color: var(--bg-dark); }
  .btn-primary:hover { background: var(--accent-hover); }
  .btn-secondary { border: 1px solid var(--border); color: var(--text-main); }
  .btn-secondary:hover { background: var(--border); }

  /* Sections General */
  section { padding: 6rem 0; border-bottom: 1px solid var(--border); }
  .section-title { font-size: 2rem; font-weight: 700; margin-bottom: 1rem; }
  .section-title.centered { text-align: center; margin-bottom: 4rem; }
  .section-subtitle { color: var(--text-muted); font-size: 1.1rem; }

  /* About */
  .about-content p { margin-bottom: 1.5rem; color: var(--text-muted); }
  .about-content strong { color: var(--text-main); }

  /* Metrics */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
  .metric-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2.5rem 2rem;
    border-radius: 12px;
    text-align: center;
  }
  .metric-value-container {
    color: var(--accent);
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .metric-label { font-size: 1.2rem; margin-bottom: 0.75rem; font-weight: 600; }
  .metric-desc { color: var(--text-muted); font-size: 0.95rem; }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .skill-card {
    border: 1px solid var(--border);
    padding: 2rem;
    border-radius: 8px;
    transition: transform 0.2s;
  }
  .skill-card:hover { transform: translateY(-4px); border-color: var(--accent); }
  .skill-card h3 { font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--text-main); }
  .skill-card p { color: var(--text-muted); font-size: 0.9rem; }

  /* Footer */
  .footer { padding: 6rem 0 3rem 0; text-align: center; background: #0b111e; }
  .footer-title { font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; }
  .footer-lead { color: var(--text-muted); max-width: 600px; margin: 0 auto 2.5rem auto; }
  .footer-details { margin-bottom: 2rem; }
  .footer-details a { color: var(--accent); text-decoration: none; }
  .footer-socials { margin-bottom: 4rem; }
  .social-link {
    color: var(--text-muted);
    text-decoration: none;
    margin: 0 1rem;
    font-weight: 500;
  }
  .social-link:hover { color: var(--accent); }
  .copyright { color: #475569; font-size: 0.85rem; }
</style>
